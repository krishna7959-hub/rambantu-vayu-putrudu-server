{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/BACKUP-*/**",
      "**/GOLDEN-BACKUP-*/**",
      "**/*.before-*",
      "**/*.backup",
      "**/*.backup.*",
      "**/*-backup.*"
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "emulators": {
    "firestore": {
      "port": 8080
    }
  }
}
